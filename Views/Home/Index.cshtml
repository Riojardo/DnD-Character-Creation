@using Microsoft.AspNetCore.Identity;
<script>
    const subClassesDict = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListsAPI.SubClassesNames));
    const subRacesDict = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListsAPI.SubRacesNames));
</script>
<script src="~/js/site.js"></script>

@{
    var UrlBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData["Title"] = "Home Page";
    var abilities = new List<string> { "STR", "DEX", "CON", "INT", "WIS", "CHA" };
    var skillsList = new List<string>
{
    "Acrobatics",
    "AnimalHandling",
    "Arcana",
    "Athletics",
    "Deception",
    "History",
    "Insight",
    "Intimidation",
    "Investigation",
    "Medicine",
    "Nature",
    "Perception",
    "Performance",
    "Persuasion",
    "Religion",
    "SleightOfHand",
    "Stealth",
    "Survival"
};
}

@model DnD_CharacterCreation.ViewModels.CharacterViewModel
@inject SignInManager<Users> signInManager;


<div class="text-center">
    <h1 class="display-4">Welcome to your D&D character creator!</h1>
    @if (signInManager.IsSignedIn(User))
    {
        <p>Learn all you need about D&D here : <a href="https://dnd5e.wikidot.com/" target="_blank" rel="noopener noreferrer">Wikidot.com</a>.</p>
    }
    else
    {
        <p> You need to be connected to create you Character.</p>
    }
</div>
@if (signInManager.IsSignedIn(User))
{
    <form asp-controller="Character" asp-action="Create" method="post">
        <div class="form-slider">
            <!-- Box 1 -->
            <div class="form-box form-box-1">
                <button class="slide-btn slide-btn-right" type="button">
                    <img src="@Url.Content("~/images/triangle-blancsur-fond-noir.png")" alt="Next" class="dice_button">
                </button>
                <div class="form-content-inner">
                    <!-- Character Name -->
                    <div class ="character_name">
                        <label for="Character_name" >Character Name:</label>
                        <input asp-for="CharacterName" type="text" required title="Please name your character..."/>

                    </div>

                    <!-- Gender -->
                    <label for="gender">Gender:</label>
                    <select name="gender">
                        <option value="">Please select one…</option>
                        <option value="female">Female</option>
                        <option value="male">Male</option>
                        <option value="non-binary">Non-Binary</option>
                        <option value="other">Other</option>
                        <option value="Prefer not to answer">Prefer not to answer</option>
                    </select>

                    <!-- Classes -->
                    <label for="Classe">Choose your Class:</label>

                    <!-- First Class -->
                    <div class="class-row visible" id="row_first">
                        <div class="select-group">
                            <select id="classe_first" name="Classe_first" asp-for="Classe_First" asp-items="@(new SelectList(Model.ListsAPI.ClassesNames, "Key", "Value"))">
                            </select>
                            <select id="level_first" asp-for="Levelclasss_First" class="form-control">
                                @for (int i = 1; i <= 20; i++)
                                {
                                    <option value="@i" selected="@(Model.Levelclasss_First == i ? "selected" : null)">
                                        @i
                                    </option>
                                }
                            </select>
                            <select id="subclasse_first" name="Subclasse_first" asp-for="Subclasse_First">

                            </select>

                        </div>
                        <button type="button" class="add-btn" id="classe2_button">➕ Add class</button>
                    </div>

                    <!-- Second Class -->
                    <div class="class-row" id="row_second">
                        <div class="select-group">
                            <select id="classe_second" name="Classe_second" asp-for="Classe_Second" asp-items="@(new SelectList(Model.ListsAPI.ClassesNames,  "Key", "Value"))">
                                <option value="" selected disabled></option>
                            </select>
                            <select id="level_second" asp-for="Levelclasss_Second" >
                                <option value=""></option>

                            </select>
                            <select id="subclasse_second" name="Subclasse_second" asp-for="Subclasse_Second" >
                            </select>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <button type="button" class="add-btn" id="classe3_button">➕</button>
                            <button type="button" class="remove-btn" id="remove_second">❌</button>
                        </div>
                    </div>

                    <!-- Third Class -->
                    <div class="class-row" id="row_third">
                        <div class="select-group">
                            <select id="classe_third" name="Classe_third" asp-for="Classe_Third" asp-items="@(new SelectList(Model.ListsAPI.ClassesNames,  "Key", "Value"))">
                                <option value="" selected disabled></option>
                            </select>
                            <select id="level_third" asp-for="Levelclasss_Third">
                                <option value=""></option>                                   
                            </select>
                            <select id="subclasse_third" name="Subclasse_third" asp-for="Subclasse_Third">
                            </select>
                        </div>
                        <button type="button" class="remove-btn" id="remove_third">❌</button>
                    </div>

                    <!-- Alignment -->
                    <label for="alignment">Choose an alignment:</label>
                    <select name="alignment" id="alignment">
                        <option value="LG">Lawful Good</option>
                        <option value="NG">Neutral Good</option>
                        <option value="CG">Chaotic Good</option>
                        <option value="LN">Lawful Neutral</option>
                        <option value="N">True Neutral</option>
                        <option value="CN">Chaotic Neutral</option>
                        <option value="LE">Lawful Evil</option>
                        <option value="NE">Neutral Evil</option>
                        <option value="CE">Chaotic Evil</option>
                    </select>

                    <!-- Background -->
                    <label for="background">Choose A Background:</label>
                    <select name="BackgroundId" id="background" asp-for="BackgroundId">
                        <option value=""></option>
                        @foreach (var background in Model.ListsAPI.Background)
                        {
                            <option value="@background.BackgroundId">@background.Name (@background.PrimarySkill/@background.SecondarySkill)</option>
                        }
                    </select>
                </div>
            </div>
            <!-- Box 2 --> 
            <div class="form-box form-box-2">
                <button class="slide-btn slide-btn-left" type="button"> 
                    <img src="@Url.Content("~/images/triangle-blancsur-fond-noir.png")" alt="Previous">
                </button> 
                <button class="slide-btn slide-btn-right" type="button"> <img src="@Url.Content("~/images/triangle-blancsur-fond-noir.png")" alt="Next"> 
                </button>
                <div class="form-content-inner">
                    <!-- Species -->

                    <label for="species">Choose A Species:

                    </label>
                    <select  id="species" asp-for="Species" asp-items="@(new SelectList(Model.ListsAPI.RacesNames,  "Key", "Value"))"></select>
                    <label for="Subspecies">
                        Choose A Subspecies:
                    </label>
                    <select  id="subspecies" asp-for="Subspecies">
                        <option value=""></option>
                    </select>

                    <!-- Dice / stats --> 

                    <div class="label-abilities_choice"> 
                        <span>Click on the Dice to Determine your stats :</span>
                        <button type="button" class="dice-btn" aria-label="Roll stats" id="button-stats"> 
                            <img src="@Url.Content("~/images/Dice20_button.png")" alt="Roll Dice" /> 
                        </button>
                        <span id="stats-display">0, 0, 0, 0, 0, 0</span> 
                    </div>
                    <!-- Header -->

                    <div class="label-abilities_description">
                        <div class="col-left"><span>Stats :</span>
                        </div> <div class="col-middle"><span>Bonus :</span>
                        </div> <div class="col-right" id="totalSpan">
                            <span id="totalSpan">Total :  </span>
                        </div>
                    </div> 

                    <!-- Abilities -->
                    <div class="abilities-canvas">
                        @foreach (var ability in abilities)
                        {
                            <div class="ability-row">
                                <div class="col-left">
                                    <label for="@ability">@ability:</label>
                                    <select id="@ability" name="@ability">
                                        <option value="0" selected>00</option>
                                    </select>
                                </div>

                                <div class="col-middle">
                                    <input type="checkbox" class="scales" id="scales-1-@ability" />
                                    <label for="scales-1-@ability">+1</label>

                                    <input type="checkbox" class="scales" id="scales-2-@ability" />
                                    <label for="scales-2-@ability">+2</label>
                                </div>

                                <div class="col-right">
                                    <span id="total-@ability"> 00</span>
                                    <input type="hidden" id="total_@ability" name="total_@ability" />
                                    <script>                                
                                        document.querySelector("form").addEventListener("submit", () => {
                                        console.log(@ability + " sent:",
                                        document.getElementById(`total_@ability`).value
                                        );
                                        });
                                    </script>
                                </div>
                            </div>
                        }
                    </div>
