                    });
                </script> *@
                </div>
            </div>

            <div class="form-box form-box-3">
                <button class="slide-btn slide-btn-left" type="button">
                    <img src="@Url.Content("~/images/triangle-blancsur-fond-noir.png")" alt="Previous">
                </button>
                <div class="form-content-inner">
                    <div class="skills">
                        @foreach (var skill in skillsList)
                        {
                            <div class="skill">
                                <input type="checkbox" name="@skill" value="true" id="@skill" />
                                <input type="hidden" name="@skill" value="false" />
                                <label for="@skill">
                                    @(skill == "AnimalHandling" ? "Animal Handling" :
                                              skill == "SleightOfHand" ? "Sleight of Hand" : skill)
                                </label>

                                <input type="hidden" name="@skill" value="false" />
                            </div>
                        }
                    </div>
                    <!-- Feat -->
                    <div class="feats">
                        <label for="feat">Choose Your Feats:</label>

                        <button type="button" id="openFeats">Choose Feats</button>

                        <input type="hidden" id="chosenFeats" name="chosenFeats" />

                        <dialog id="featDialog">
                            <div id="view-menu">
                                <h3>Level Up: Choose Your Bonus</h3>
                                <p>Available Slots: <span id="slots-remaining">0</span></p>
                                <button type="button" id="btn-to-stats">Bonus Stats (+2 or 1/1)</button>
                                <button type="button" id="btn-to-feats">Choose a Feat</button>
                                <hr>
                                <button type="button" id="confirmFeats">Finish</button>
                            </div>

                            <div id="view-stats" style="display:none;">
                                <h3>Increase Ability Scores</h3>
                                <p>Select the stat to increase by +1 (Max 2 per slot):</p>
                                <div id="stats-options">
                                    <label>STR : <input type="number" name="stat_str" class="stat-increment" value="0" min="0" max="2"></label><br>
                                    <label>DEX : <input type="number" name="stat_dex" class="stat-increment" value="0" min="0" max="2"></label><br>
                                    <label>CON : <input type="number" name="stat_con" class="stat-increment" value="0" min="0" max="2"></label><br>
                                    <label>INT : <input type="number" name="stat_int" class="stat-increment" value="0" min="0" max="2"></label><br>
                                    <label>WIS : <input type="number" name="stat_wis" class="stat-increment" value="0" min="0" max="2"></label><br>
                                    <label>CHA : <input type="number" name="stat_cha" class="stat-increment" value="0" min="0" max="2"></label><br>
                                </div>
                                <button type="button" class="btn-back">Back</button>
                                <p style="display: inline-block; margin-left: 10px;">
                                    (Maximum ability score of 20; excess values will be discarded)
                                </p>
                            </div>

                            <div id="view-feats" style="display:none;">
                                <h3>Select Feats</h3>
                                <div class="feat-list">
                                    @foreach (var feat in Model.ListsAPI.FeatNames)
                                    {
                                        <label><input type="checkbox" class="feat-cb" value="@feat.FeatId"> @feat.Name @feat.Description</label>
                                        <br>
                                    }
                                </div>
                                <button type="button" class="btn-back">Back</button>
                            </div>
                        </dialog>

