@model DnD_CharacterCreation.ViewModels.CharacterViewModel
@inject SignInManager<Users> signInManager;



<div class="text-center">
    <h1 class="display-4">Welcome to your D&D character creator!</h1>
    @if (signInManager.IsSignedIn(User))
    {
        <p>Learn all you need about D&D here : <a href="https://dnd5e.wikidot.com/" target="_blank" rel="noopener noreferrer">Wikidot.com</a>.</p>
    }
    else
    {
        <p> You need to be connected to create you Character.</p>
    }
</div>
 @if (signInManager.IsSignedIn(User))
