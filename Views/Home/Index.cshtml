@{
    ViewData["Title"] = "Home Page";
}
@{
    var abilities = new List<string> { "STR", "DEX", "CON", "INT", "WIS", "CHA" };
}
@model DnD_CharacterCreation.ViewModels.DnDLists

<div class="text-center">
    <h1 class="display-4">Welcome to your D&D character creator!</h1>
    <p>Learn all you need about D&D here : <a href="https://dnd5e.wikidot.com/" target="_blank" rel="noopener noreferrer">Wikidot.com</a>.</p>
</div>

<div class="form-container">
    <form asp-controller="Characters" asp-action="Submit" method="post">
        <div class="form-row">
            <!-- Left Box -->
            <div class="form-box">
                <button class="slide-left-btn" type="button">
                    <img src="@Url.Content("~/images/triangle-blancsur-fond-noir.png")" alt="Slide Left">
                </button>
                <!-- Character Name -->
                <label for="Character_name">Character Name:</label>
                <input type="text" name="first-name" />

                <!-- Gender -->
                <label for="gender">Gender:</label>
                <select name="gender">
                    <option value="">Please select one…</option>
                    <option value="female">Female</option>
                    <option value="male">Male</option>
                    <option value="non-binary">Non-Binary</option>
                    <option value="other">Other</option>
                    <option value="Prefer not to answer">Prefer not to answer</option>
                </select>

                <!-- Classes -->
                <label for="Classe">Choose your Class:</label>

                <!-- First Class -->
                <div class="class-row" id="row_first">
                    <div class="select-group">
                        <select id="classe_first" name="classe_first">
                            @foreach (var name in Model.ClassesNames)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <select id="level_first" name="level_first">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <button type="button" class="add-btn" id="classe2_button">➕ Add class</button>
                </div>

                <!-- Second Class -->
                <div class="class-row" id="row_second">
                    <div class="select-group">
                        <select id="classe_second" name="classe_second">
                            @foreach (var name in Model.ClassesNames)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <select id="level_second" name="level_second">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <button type="button" class="add-btn" id="classe3_button">➕ Add class</button>
                        <button type="button" class="remove-btn" id="remove_second">❌</button>
                    </div>
                </div>

                <!-- Third Class -->
                <div class="class-row" id="row_third">
                    <div class="select-group">
                        <select id="classe_third" name="classe_third">
                            @foreach (var name in Model.ClassesNames)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <select id="level_third" name="level_third">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <button type="button" class="remove-btn" id="remove_third">❌</button>
                </div>

                <!-- Alignement -->
                <label for="alignment">Choose an alignment:</label>
                <select name="alignment" id="alignment">
                    <option value="LG">Lawful Good</option>
                    <option value="NG">Neutral Good</option>
                    <option value="CG">Chaotic Good</option>
                    <option value="LN">Lawful Neutral</option>
                    <option value="N">True Neutral</option>
                    <option value="CN">Chaotic Neutral</option>
                    <option value="LE">Lawful Evil</option>
                    <option value="NE">Neutral Evil</option>
                    <option value="CE">Chaotic Evil</option>
                </select>
          
                <!-- Background -->
                <label for="background">Choose A Background:</label>
                <select name="background" id="background">
                    <option value="acolyte">Acolyte</option>
                    <option value="criminal">Criminal</option>
                    <option value="folkhero">Folk Hero</option>
                    <option value="noble">Noble</option>
                </select>
            </div>

            <!-- Right Box -->
            <div class="form-box">

                <!-- Species -->
                <label for="species">Choose A Species:</label>
                <select name="species" id="species">
                    <option value="human">Human</option>
                    <option value="elf">Elf</option>
                    <option value="dwarf">Dwarf</option>
                    <option value="halfling">Halfling</option>
                </select>


                <!-- Abilities -->
                <div class="label-abilities_choice">
                    <span>Click on the Dice to Determine your stats :</span>
                    <button type="button" class="dice-btn" aria-label="Roll stats" id="button-stats">
                        <img src="@Url.Content("~/images/Dice20_button.png")" alt="Roll Dice" />
                    </button>
                    <span id="stats-display">0, 0, 0, 0, 0, 0</span>
                </div>
                <div class="label-abilities_description">
                    <span>Stats :</span>
                    <span>Bonus :</span>
                    <span>Total :</span>
                </div>
                <div class="abilities-canvas">
                @foreach (var ability in abilities)
                {
                    <div class="ability-row">
                        <label for="@ability">@ability:</label>
                        <select id="@ability" name="@ability">
                            <option value=""></option>
                        </select>
                        <input type="checkbox" class="scales" id="scales-1-@ability" />
                        <label for="scales-1-@ability">+1</label>
                        <input type="checkbox" class="scales" id="scales-2-@ability" />
                        <label for="scales-2-@ability">+2</label>
                        <span for="total-@ability" id="total-@ability"></span>                       
                    </div>
                }
                </div>
                <!-- Feat -->
                <label for="feat">Choose Your Feats:</label>
                <select name="feat" id="feat">
                    <option value="acolyte">Acolyte</option>
                    <option value="criminal">Criminal</option>
                    <option value="folkhero">Folk Hero</option>
                    <option value="noble">Noble</option>
                </select>
            </div>
        </div>

        <!-- Submit button below both boxes -->
        <div class="submit_All-button">
            <input type="submit" value="Submit !" class="fancy-submit">
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const maxLevel = 20;

        const rows = [
            { classe: "classe_first", level: "level_first", row: "row_first" },
            { classe: "classe_second", level: "level_second", row: "row_second" },
            { classe: "classe_third", level: "level_third", row: "row_third" }
        ];

        // --- Populate level selects based on maxLevel ---
        function populateLevels() {
            const selectedLevels = rows.map(r => parseInt(document.getElementById(r.level).value) || 0);
            const totalSelected = selectedLevels.reduce((a,b)=>a+b, 0);

            rows.forEach(r => {
                const sel = document.getElementById(r.level);
                const currentValue = parseInt(sel.value) || 0;
                sel.innerHTML = "";
                const remaining = maxLevel - (totalSelected - currentValue);

                for (let i = 1; i <= remaining; i++) {
                    const opt = document.createElement("option");
                    opt.value = i;
                    opt.textContent = i;
                    if (i === currentValue) opt.selected = true;
                    sel.appendChild(opt);
                }
            });
        }

        // --- Disable already chosen classes in other selects ---
        function updateAvailableClasses() {
            const selected = rows.map(r => document.getElementById(r.classe).value).filter(v => v);

            rows.forEach(r => {
                const sel = document.getElementById(r.classe);
                const options = sel.querySelectorAll("option");
                options.forEach(opt => {
                    if (selected.includes(opt.value) && opt.value !== sel.value) {
                        opt.disabled = true;
                    } else {
                        opt.disabled = false;
                    }
                });
            });
        }

        // --- Remove a row ---
        function removeRow(rowId) {
            const row = document.getElementById(rowId);
            const selects = row.querySelectorAll("select");
            selects.forEach(s => s.value = ""); // reset select values
            row.hidden = true;
            updateAvailableClasses();
            populateLevels();
        }

        // --- Roll stats ---
        function createStats() {
            const totalArray = [];
            for (let i = 0; i < 6; i++) {
                const inputArray = [];
                for (let j = 0; j < 4; j++) {
                    inputArray.push(Math.floor(Math.random() * 6) + 1);
                }
                inputArray.sort((a,b) => a - b);
                const sum = inputArray.slice(1).reduce((acc, curr) => acc + curr, 0);
                totalArray[i] = sum;
            }
            return totalArray;
        }

        const buttonStats = document.getElementById('button-stats');
        const displayStats = document.getElementById('stats-display');

        buttonStats.addEventListener('click', () => {
            const totalArray = createStats();
            displayStats.textContent = totalArray.join(', ');

            document.querySelectorAll(".ability-row select").forEach((select, index) => {
                select.innerHTML = "<option value=''></option>";
                totalArray.forEach(value => {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = value;
                    select.appendChild(option);
                });
                select.addEventListener("change", updateAvailableStats);
            });          
            updateAvailableStats();

        });

        // --- Prevent duplicate stats in selects ---
        function updateAvailableStats() {
            const selects = document.querySelectorAll(".ability-row select");
            if (selects.length === 0) return;

            const rolledValues = Array.from(selects[0].options)
                .map(opt => opt.value)
                .filter(v => v !== "");

            const rolledCount = {};
            rolledValues.forEach(v => {
                if (!rolledCount[v]) rolledCount[v] = 0;
                rolledCount[v]++;
            });

            const chosenCount = {};
            selects.forEach(select => {
                if (select.value !== "") {
                    if (!chosenCount[select.value]) chosenCount[select.value] = 0;
                    chosenCount[select.value]++;
                }
            });

            selects.forEach(select => {
                const currentValue = select.value;
                Array.from(select.options).forEach(opt => {
                    if (opt.value === "") {
                        opt.disabled = false;
                        return;
                    }
                    const totalAvailable = rolledCount[opt.value] || 0;
                    const alreadyChosen = chosenCount[opt.value] || 0;
                    opt.disabled = !(opt.value === currentValue || alreadyChosen < totalAvailable);
                });
            });
             updateTotalStats();
        }

        // --- Checkboxes +1/+2 per row ---
        const abilityRows = document.querySelectorAll('.ability-row');
        abilityRows.forEach(row => {
            const checkboxes = row.querySelectorAll('.scales');
            checkboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    if (cb.checked) {
                        checkboxes.forEach(other => {
                            if (other !== cb) other.checked = false;
                        });
                    }
                    updateTotalStats();
                });
            });
        });
         const checkboxes = document.querySelectorAll('.scales');
        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                if (cb.checked) {
                    const type = cb.id.split('-')[1]; // "1" or "2"
                    checkboxes.forEach(other => {
                        if (other !== cb && other.id.includes(`scales-${type}-`)) {
                            other.checked = false;
                        }
                    });
                }
                updateTotalStats();
            });
        });

               function updateTotalStats() {
        const rows = document.querySelectorAll('.ability-row');

        rows.forEach(row => {
            const select = row.querySelector('select');
            const checkboxes = row.querySelectorAll('input[type="checkbox"]');
            const span = row.querySelector('span');

            let totalValue = 0;

            if (select.value !== "") {
                totalValue += parseInt(select.value);
            }

            checkboxes.forEach(cb => {
                if (cb.checked) {
                    if (cb.id.includes('-1-')) totalValue += 1;
                    else if (cb.id.includes('-2-')) totalValue += 2;
                }
            });

            // Only display if totalValue >= 3
            span.textContent = totalValue >= 3 ? totalValue : "";
        });
    }

        // --- Initial population ---
        populateLevels();
        updateAvailableClasses();
        updateAvailableStats();

        // --- Event listeners for class & level selects ---
        rows.forEach(r => {
            const classeSel = document.getElementById(r.classe);
            const levelSel = document.getElementById(r.level);

            classeSel.addEventListener("change", updateAvailableClasses);
            levelSel.addEventListener("change", populateLevels);
        });

        // --- Show extra rows ---
        document.getElementById("classe2_button").addEventListener("click", () => {
            document.getElementById("row_second").hidden = false;
            populateLevels();
        });
        document.getElementById("classe3_button").addEventListener("click", () => {
            document.getElementById("row_third").hidden = false;
            populateLevels();
        });

        // --- Remove rows ---
        document.getElementById("remove_second").addEventListener("click", () => removeRow("row_second"));
        document.getElementById("remove_third").addEventListener("click", () => removeRow("row_third"));
    });
</script>