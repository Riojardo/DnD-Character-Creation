                    </div>
                    <div class="skill">
                        <input type="checkbox" id="insight" name="skills" />
                        <label for="insight">Insight</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="intimidation" name="skills" />
                        <label for="intimidation">Intimidation</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="investigation" name="skills" />
                        <label for="investigation">Investigation</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="medicine" name="skills" />
                        <label for="medicine">Medicine</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="nature" name="skills" />
                        <label for="nature">Nature</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="perception" name="skills" />
                        <label for="perception">Perception</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="performance" name="skills" />
                        <label for="performance">Performance</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="persuasion" name="skills" />
                        <label for="persuasion">Persuasion</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="religion" name="skills" />
                        <label for="religion">Religion</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="sleight_of_hand" name="skills" />
                        <label for="sleight_of_hand">Sleight of Hand</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="stealth" name="skills" />
                        <label for="stealth">Stealth</label>
                    </div>
                    <div class="skill">
                        <input type="checkbox" id="survival" name="skills" />
                        <label for="survival">Survival</label>
                    </div>
                </div>
                <!-- Feat -->
                <div class=" feats">
                    <label for="feat">Choose Your Feats:</label>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                    <div class="human-feat">
                        <select name="feat" id="feat">
                            <option value="acolyte">Acolyte</option>
                            <option value="criminal">Criminal</option>
                            <option value="folkhero">Folk Hero</option>
                            <option value="noble">Noble</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="submit_All-button">
            <input type="submit" value="Submit !" class="fancy-submit">
        </div>
     </form> 
}
