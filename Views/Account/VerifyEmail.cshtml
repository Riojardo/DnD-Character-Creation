@using DnD_CharacterCreation.ViewModels;
@model VerifyEmailViewModel;

@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Account Verification</h2>

        <div class="alert alert-info text-center" role="alert">
            Check your Email for the verification code :D
        </div>

        <form asp-action="VerifyEmail" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

           
            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="CodeInput" class="form-label">Verification Code</label>
                <input asp-for="CodeInput" class="form-control text-center" placeholder="123456" maxlength="6" style="font-size: 20px; letter-spacing: 4px; font-weight: bold;" autocomplete="off" />
                <span asp-validation-for="CodeInput" class="text-danger"></span>
                
            </div>

            <input type="submit" value="Verify & Create Account" class="btn btn-primary w-100 p-2" />

            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Back to Register</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}