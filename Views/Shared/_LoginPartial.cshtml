@using Microsoft.AspNetCore.Identity;
@inject SignInManager<Users> signInManager;

<ul classe ="navbar-nav ms-auto">
    @if(signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a classe="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
        </li>

    }
    else
    {
        <li class="nav-item">
            <a classe="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
        </li>
        <li class="nav-item">
            <a classe="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
        </li>
    }

   </ul>